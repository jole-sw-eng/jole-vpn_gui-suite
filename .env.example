# Copy to .env (never commit .env), then: sudo chmod 600 .env
# Keep comments on their own lines; do not put "# ..." after a value.

# Where the admin UI is published on the host. Pick ONE:
#   127.0.0.1           loopback only: browse on the server itself (smallest exposure, default)
#   <server LAN IP>     e.g. 192.168.1.10: browse from other machines on your LAN
# Never 0.0.0.0. See docs/02-setup-tutorial.md, step 4.
WEB_BIND=127.0.0.1
WEB_PORT=8443

# Optional source allowlist for the UI, comma-separated CIDRs.
# Leave empty with the loopback bind. With a LAN bind use e.g. 192.168.1.0/24,
# or a single admin machine such as 192.168.1.20/32.
WEB_ALLOW_CIDRS=

# Must match PORT/PROTO chosen in setup (the router forwards only this port)
JOLE_VPN_PORT=1194
JOLE_VPN_PROTO=udp
# JOLE_WEB=0 disables the UI (pure v1 behaviour)
# JOLE_WEB=1
